{
  "name": "system",
  "private": true,
  "version": "0.1.0",
  "description": "System — personal productivity operating system",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @system/desktop dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @system/desktop build",
    "test": "pnpm -r --filter=./packages/* test && pnpm --filter @system/desktop test",
    "test:domain": "pnpm --filter @system/domain test",
    "test:e2e": "pnpm --filter @system/desktop test:e2e",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop"
  },
  "engines": {
    "node": ">=20"
  }
}
