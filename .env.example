# System — local / hosted Supabase (never commit real secrets)
# Copy to .env and fill values from `supabase status` (local) or project settings (hosted).

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Edge Functions / scripts — do not expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# App
VITE_APP_NAME=System
VITE_DEFAULT_TIMEZONE=America/Chicago
